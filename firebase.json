{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/invite",
        "destination": "/invite.html"
      }
    ],
    "redirects": [
      {
        "source": "/agent",
        "destination": "https://github.com/adrockisahussla/ChoreBuddy-Agent/releases/latest",
        "type": 302
      },
      {
        "source": "/agent/download",
        "destination": "https://github.com/adrockisahussla/ChoreBuddy-Agent/releases/latest/download/ChoreBuddyAgent.zip",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
