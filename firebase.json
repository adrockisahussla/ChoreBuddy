{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/invite",
        "destination": "/invite.html"
      },
      {
        "source": "/agent",
        "destination": "/agent.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
