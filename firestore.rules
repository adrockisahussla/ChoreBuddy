rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inMyFamily(familyId) {
      return hasUserDoc() && myUser().familyId == familyId;
    }

    function amManager() {
      return hasUserDoc() && myUser().role == 'manager';
    }

    match /users/{uid} {
      allow read: if isMe(uid)
        || (hasUserDoc() && resource.data.familyId == myUser().familyId);
      allow create: if isMe(uid) && request.resource.data.uid == uid;
      // Self can update their own doc (uid must remain pinned).
      // Same-family managers can update OTHER family members' docs but
      // only the `minutesRemaining` field — used when fulfilling a
      // screen-time claim to credit the kid's wallet.
      allow update: if (isMe(uid) && request.resource.data.uid == uid)
        || (amManager()
             && resource.data.familyId == myUser().familyId
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minutesRemaining']));
      allow delete: if isMe(uid)
        || (amManager() && resource.data.familyId == myUser().familyId);
    }

    match /families/{fid} {
      allow read: if inMyFamily(fid);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if inMyFamily(fid);
      allow delete: if amManager() && inMyFamily(fid);
    }

    match /chores/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /chorePool/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /rewardPool/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /rewards/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /rewardClaims/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /reminders/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    match /invites/{id} {
      allow read: if inMyFamily(resource.data.familyId)
        || (isSignedIn() && request.auth.token.email != null && resource.data.email != null && request.auth.token.email.lower() == resource.data.email.lower());
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update: if inMyFamily(resource.data.familyId)
        || (isSignedIn() && request.auth.token.email != null && resource.data.email != null && request.auth.token.email.lower() == resource.data.email.lower());
      allow delete: if inMyFamily(resource.data.familyId);
    }

    // Active screen-time burns — one per fulfilled claim, owned by the
    // family. Manager devices reconcile expirations via the
    // useScreenTimeBurner hook. Kids can't write; reading is family-
    // scoped so a buddy can see their own running clock if we ever add
    // a "Time left: 12 min" UI.
    match /screenTimeBurns/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if amManager() && inMyFamily(request.resource.data.familyId);
      allow update, delete: if amManager() && inMyFamily(resource.data.familyId);
    }

    // GameWall play schedules — one doc per buddy (id === buddyUid),
    // scoped to the family. Managers create/edit; family members can read.
    match /gameSchedules/{id} {
      allow read: if inMyFamily(resource.data.familyId);
      allow create: if inMyFamily(request.resource.data.familyId);
      allow update, delete: if inMyFamily(resource.data.familyId);
    }

    // Per-machine firewall control plane. Docs are keyed by machine id,
    // not family, so we can't gate by familyId. Managers in any family
    // can issue SHUTOFF/ALLOW commands; the Windows agents that poll
    // these docs run on the manager's own PCs.
    match /firewallControl/{machineId} {
      allow read, write: if amManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
